# Copy to .env and fill in. .env is gitignored; never commit keys.
# Run: uvicorn backend.app:app --env-file .env
# Any OpenAI-compatible chat endpoint works. Pick ONE provider block, comment out the others.

# --- OpenRouter (default; free models end in ":free", ~1000 req/day once the account holds 10 credits) ---
OPENROUTER_API_KEY=sk-or-your-key-here
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Groq (free, ~14,400 req/day; key from console.groq.com/keys; check the model name in their docs) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk-your-key-here
# CHAT_MODEL=<a model id listed in Groq's docs>

# --- Google Gemini (free tier; key from aistudio.google.com/apikey) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-key-here
# CHAT_MODEL=<a Flash model id listed in Google's docs>

# Optional: MLflow tracing + the retrieval ladder (pip install -r requirements-eval.txt)
# MLFLOW_TRACKING_URI=sqlite:///data/runtime/mlflow.db

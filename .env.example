# Copy to .env and fill in. .env is gitignored; never commit keys.
# Run: uvicorn app:app --env-file .env
# Key from openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
# Free models end in ":free" (list: openrouter.ai/models?q=free). Free tier is rate-limited.
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
